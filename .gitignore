# This folder is the full decompiled Dome Keeper project: not ours to redistribute.
# Git tracks only our own files. Everything else is ignored by default.
# To track a new top-level file or folder of ours, add a "!/<name>" line below.

/*

!/.gitignore
!/README.md
!/override.cfg
!/.gitattributes
!/CLAUDE.md
!/GLOSSARY.md
!/docs/
!/art/
!/mods-unpacked/
!/release/

# Engine caches and build output, wherever they appear (e.g. art/tools/engine_render)
.godot/
*.tmp

# Godot import sidecars the editor writes next to images in docs/
/docs/**/*.import

# Score previews and Python caches (art/music/score.py --preview)
/art/music/preview/
__pycache__/

# Builder notes (handoffs, review drafts): local only
/.scratch/
